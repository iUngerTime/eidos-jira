{
  "name": "@iungertime/jira",
  "version": "0.1.1",
  "private": true,
  "description": "Jira Cloud for Eidos MD: pull a board's issues into the Backlog as tasks, and their comments as threads signed by the people who wrote them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iUngerTime/eidos-jira.git"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/build.mjs && node --test --experimental-strip-types \"test/*.test.ts\"",
    "install-local": "node scripts/install-local.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eidosmd": "link:../eidosmd/cli",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "@types/react": "^18.3.12"
  },
  "engines": {
    "node": ">=22.6"
  }
}
